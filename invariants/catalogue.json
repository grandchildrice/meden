{
  "version": "v0",
  "invariants": [
    {
      "id": "inv.v0.untrusted-data-never-steers",
      "means": "A call is refused whenever any argument that steers it carries a source outside the trusted set. The conclusion follows from the label alone, so no prompt, model or classifier takes part in it.",
      "lean": {
        "file": "TAgentSpec/Flow.lean",
        "theorem": "untrusted_control_refused"
      },
      "statement_sha256": "2008f67dd32ffd0d1e3566109321c95c0483594f64ad5605c8afaffda6cb783c"
    },
    {
      "id": "inv.v0.no-disclosure-to-a-non-reader",
      "means": "A call is refused whenever any of its arguments may not be read by the principal the call discloses to.",
      "lean": {
        "file": "TAgentSpec/Flow.lean",
        "theorem": "unreadable_not_disclosed"
      },
      "statement_sha256": "b1e56d2173df787090fd667cdaefb272afec155b19cfb40d7b2e2129e9f3010d"
    },
    {
      "id": "inv.v0.taint-survives-a-join",
      "means": "Joining a label with an untrusted one yields an untrusted label: combining data never launders where it came from.",
      "lean": {
        "file": "TAgentSpec/Flow.lean",
        "theorem": "join_untrusted_left"
      },
      "statement_sha256": "79124c435e01731b04f942dac85f8b645411325ff5bb3c69b24ea3ff9b0541a3"
    },
    {
      "id": "inv.v0.readers-narrow-on-a-join",
      "means": "A principal may read a combined value only if it may read both parts. Confidentiality narrows as data is combined, the opposite direction to provenance.",
      "lean": {
        "file": "TAgentSpec/Flow.lean",
        "theorem": "meet_allows"
      },
      "statement_sha256": "0bb5ba3187031bb059ff15a332b2a60f5842bf8bc66c2f83c98e102069cb4add"
    },
    {
      "id": "inv.v0.one-more-argument-never-permits",
      "means": "Adding an argument to a refused call leaves it refused. A refusal cannot be undone by sending more.",
      "lean": {
        "file": "TAgentSpec/Flow.lean",
        "theorem": "integrity_cons"
      },
      "statement_sha256": "dc93e85e453ba9b0a2c4fd4bd26291ed1721835cfa625e18c32e524b52beed23"
    },
    {
      "id": "inv.v0.deny-overrides-grant",
      "means": "A requirement matched by a deny is refused however many grants also match it.",
      "lean": {
        "file": "TAgentSpec/Policy.lean",
        "theorem": "deny_wins"
      },
      "statement_sha256": "da1055b7362e3984f22e21e7e3b31c628edbb8a22f9280bbdae0e000ce1c03fd"
    },
    {
      "id": "inv.v0.allowed-iff-every-requirement-is-covered",
      "means": "A set of requirements is allowed exactly when each one is covered by a grant and matched by no deny. There is no other path to an allow.",
      "lean": {
        "file": "TAgentSpec/Policy.lean",
        "theorem": "allowed_iff"
      },
      "statement_sha256": "03d5d63483c7ce1f788b5ea96d32dd7aa1dac3b75b5afa33606e47923d248505"
    },
    {
      "id": "inv.v0.more-grants-never-refuse-more",
      "means": "Adding a grant to a policy never turns an allowed request into a refused one.",
      "lean": {
        "file": "TAgentSpec/Policy.lean",
        "theorem": "grants_monotone"
      },
      "statement_sha256": "fd1b90a275104cdb58ba63b048a6c40328f85ced6c3bdeee069c9f333d17191b"
    },
    {
      "id": "inv.v0.more-denies-never-allow-more",
      "means": "Adding a deny to a policy never turns a refused request into an allowed one.",
      "lean": {
        "file": "TAgentSpec/Policy.lean",
        "theorem": "denies_antitone"
      },
      "statement_sha256": "8502b99534a690e6813b4e697ee7a33788933a171df4df1e831f795272800d59"
    },
    {
      "id": "inv.v0.a-scoped-grant-is-not-a-blanket",
      "means": "A grant carrying a scope does not cover a requirement that names no scope. Narrowing a grant cannot accidentally widen it.",
      "lean": {
        "file": "TAgentSpec/Policy.lean",
        "theorem": "scoped_grant_not_covers_unscoped"
      },
      "statement_sha256": "2e875bc34daf79bf9dc71e8df0a32993c0d3f6fbeb277293179e1505f466ac67"
    },
    {
      "id": "inv.v0.verified-requires-a-lean-only-tcb",
      "means": "An attestation is classified Verified only if its trusted computing base is Lean alone. Evidence from any other prover is labelled with what it trusts.",
      "lean": {
        "file": "TAgentSpec/Attestation.lean",
        "theorem": "verified_implies_lean_only"
      },
      "statement_sha256": "d5fa4e18b2f0cd18e98a010865d82d5283aa7b3747c20a32e75513a268f3e47b"
    },
    {
      "id": "inv.v0.tests-never-confer-verified",
      "means": "Evidence whose result is not `proved` is never Verified, whatever its trusted computing base says. A passing test suite is not a proof.",
      "lean": {
        "file": "TAgentSpec/Attestation.lean",
        "theorem": "tested_never_verifies"
      },
      "statement_sha256": "9db28892263e476be2657b8adba26666fb139cf2efd33a935081cf164d519a25"
    },
    {
      "id": "inv.v0.a-foreign-prover-needs-approval",
      "means": "Evidence from a prover whose property mapping no human has approved is not accepted as verified.",
      "lean": {
        "file": "TAgentSpec/Attestation.lean",
        "theorem": "tier_foreign_unapproved"
      },
      "statement_sha256": "49252e91f50fb167c51eda39d8426624f977f9ba24ec6bf74ec5749581f8c6a2"
    }
  ]
}
