  ],
  "parameters": [
    "amount"
  ],
  "function": "increment",
  "specification": "if s.value + amount ≤ 18446744073709551615 then { value := s.value + amount } else s",
  "properties": [
    {
      "name": "monotone",
      "description": "The counter never decreases.",
      "statement": "s.value ≤ out.value"
    },
    {
      "name": "bounded",
      "description": "The result fits in u64.",
      "statement": "out.value ≤ 18446744073709551615"
    },
    {
      "name": "zero_identity",
      "description": "A zero increment leaves state unchanged.",
      "statement": "amount = 0 → out = s"
    }
  ],
