{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference",
  "description": "Original session and bounded queue index, never a send capability.",
  "type": "object",
  "properties": {
    "session": {
      "$ref": "#/$defs/SessionId"
    },
    "id": {
      "type": "integer",
      "format": "uint8",
      "minimum": 0,
      "maximum": 7
    }
  },
  "additionalProperties": false,
  "required": [
    "session",
    "id"
  ],
  "$defs": {
    "SessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    }
  }
}
