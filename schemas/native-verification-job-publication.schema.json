{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Envelope",
  "description": "Shared wire framing; each data role retains its own generated schema.",
  "type": "object",
  "properties": {
    "revision": {
      "description": "Exact publication requested by the viewer.",
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "data": {
      "description": "Original complete projection, never an authority token.",
      "$ref": "#/$defs/Data"
    }
  },
  "additionalProperties": false,
  "required": [
    "revision",
    "data"
  ],
  "$defs": {
    "Data": {
      "description": "One latest complete observation. No successful history prefix is invented.",
      "oneOf": [
        {
          "description": "Original project proposal or accepted implementation check.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "project"
            },
            "context": {
              "description": "Frozen original project meaning.",
              "$ref": "#/$defs/Context"
            },
            "elapsed_ms": {
              "description": "Host monotonic elapsed time.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "phase": {
              "description": "Actual application boundary/result.",
              "$ref": "#/$defs/Phase"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "context",
            "elapsed_ms",
            "phase"
          ]
        },
        {
          "description": "A portable work check is historical and cannot carry admitted evidence.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "recorded"
            },
            "context": {
              "description": "Original requested work and host session.",
              "$ref": "#/$defs/Context2"
            },
            "elapsed_ms": {
              "description": "Host monotonic elapsed time.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "phase": {
              "description": "Actual historical-check boundary/result.",
              "$ref": "#/$defs/Phase2"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "context",
            "elapsed_ms",
            "phase"
          ]
        }
      ]
    },
    "Context": {
      "description": "Frozen original subject and host observation identity.",
      "type": "object",
      "properties": {
        "job": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "source_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "name": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "class": {
          "$ref": "#/$defs/Class"
        },
        "scope": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "job",
        "subject",
        "source_path",
        "name",
        "backend",
        "class",
        "scope"
      ]
    },
    "Subject": {
      "description": "Original operation subject. A draft has no accepted revision or evidence.",
      "oneOf": [
        {
          "description": "Check a new contract before offering its meaning for host review.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "proposal"
            },
            "session": {
              "description": "Original project session, not a grant.",
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "contract": {
              "description": "Complete canonical proposed contract identity.",
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "session",
            "contract"
          ]
        },
        {
          "description": "Check implementation against the host-accepted original meaning.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "accepted"
            },
            "reference": {
              "description": "Exact original accepted revision/session/contract.",
              "$ref": "#/$defs/Reference"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "reference"
          ]
        }
      ]
    },
    "Reference": {
      "description": "Lossless transport of the original selected contract identity, never authority.",
      "type": "object",
      "properties": {
        "revision": {
          "$ref": "#/$defs/NativeSequence"
        },
        "session": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "contract": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "revision",
        "session",
        "contract"
      ]
    },
    "NativeSequence": {
      "type": "string",
      "format": "meden-positive-u64",
      "pattern": "^[1-9][0-9]{0,19}$",
      "maxLength": 20
    },
    "Class": {
      "description": "Evidence strength carried by the application wire format.",
      "oneOf": [
        {
          "description": "Observations of named executions.",
          "type": "string",
          "const": "empirical"
        },
        {
          "description": "Complete checking within the named finite scope.",
          "type": "string",
          "const": "bounded"
        },
        {
          "description": "A checked theorem under named assumptions.",
          "type": "string",
          "const": "theorem"
        },
        {
          "description": "Implementation correspondence to a specification.",
          "type": "string",
          "const": "refinement"
        }
      ]
    },
    "Phase": {
      "description": "Input-bound progress and disjoint terminal observations. Diagnostics do not\nselect a phase, stop class or evidence strength.",
      "oneOf": [
        {
          "description": "A checked draft is available for review. This is not acceptance or\nimplementation evidence, including when older accepted meaning remains.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "proposed"
            },
            "reference": {
              "description": "Original newly displayed proposal reference.",
              "$ref": "#/$defs/Reference"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "reference"
          ]
        },
        {
          "description": "The host is executing this actual application stage.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "running"
            },
            "stage": {
              "description": "Exact known input, frozen along with its operation boundary.",
              "$ref": "#/$defs/Stage"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "stage"
          ]
        },
        {
          "description": "Reported only after actual project evidence admission. This display\nobservation cannot restore that receipt, acceptance or current freshness.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "admitted"
            },
            "inputs": {
              "description": "Original input binding for the actual admitted result.",
              "$ref": "#/$defs/Inputs"
            },
            "completion_label": {
              "description": "The application's original strength-specific completion text.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "inputs",
            "completion_label"
          ]
        },
        {
          "description": "Original typed failure, without classifying diagnostic words.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "failed"
            },
            "during": {
              "description": "Last actual operation boundary.",
              "$ref": "#/$defs/Stage"
            },
            "kind": {
              "description": "Original host classification.",
              "$ref": "#/$defs/FailureKind"
            },
            "message": {
              "description": "Bounded literal diagnostic, explicitly marked if shortened.",
              "type": "string",
              "maxLength": 8000
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "during",
            "kind",
            "message"
          ]
        },
        {
          "description": "Failed execution with an independently observed host cancellation flag.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "cancelled"
            },
            "during": {
              "description": "Last actual operation boundary.",
              "$ref": "#/$defs/Stage"
            },
            "message": {
              "description": "Bounded original diagnostic.",
              "type": "string",
              "maxLength": 8000
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "during",
            "message"
          ]
        }
      ]
    },
    "Stage": {
      "description": "Actual application boundary with exactly the inputs known there. A checking\nstage without prepared inputs is not representable, including after failure.",
      "oneOf": [
        {
          "description": "Validate a draft through its originally registered verifier.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "checking_proposal"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "description": "Retain the checked draft for a separate host review.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "recording_proposal"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "description": "Read the accepted source under its frozen policy.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "reading_source"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "description": "Prepare the originally registered checker and its inputs.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "preparing_checker"
            },
            "source_sha256": {
              "description": "Complete original source bytes, not metadata or a prefix.",
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "source_sha256"
          ]
        },
        {
          "description": "Execute the already-issued check.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "checking"
            },
            "inputs": {
              "description": "Original complete prepared input binding.",
              "$ref": "#/$defs/Inputs"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "inputs"
          ]
        },
        {
          "description": "Observe the source again after checker completion.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "refreshing_source"
            },
            "inputs": {
              "description": "Original check input; never replaced by the freshness read.",
              "$ref": "#/$defs/Inputs"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "inputs"
          ]
        },
        {
          "description": "Stage outputs and ask the existing controller to admit them.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "retaining_evidence"
            },
            "inputs": {
              "description": "Original check input.",
              "$ref": "#/$defs/Inputs"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "inputs"
          ]
        }
      ]
    },
    "Inputs": {
      "description": "Original captured source and the complete prepared-input serialization hash.\nA viewer cannot use these hashes to issue or complete an execution.",
      "type": "object",
      "properties": {
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prepared_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "prepared_sha256"
      ]
    },
    "FailureKind": {
      "description": "Host-attributed check failure, never decoded from model/result text.",
      "oneOf": [
        {
          "description": "A completed check did not establish the candidate's contract. This is\nnot a theorem that the contract is false; proof automation can fail too.",
          "type": "string",
          "const": "unverified"
        },
        {
          "description": "Prepared resources, host I/O or the checker protocol are unavailable.",
          "type": "string",
          "const": "unavailable"
        },
        {
          "description": "Cancellation or a resource limit prevented a conclusive check.",
          "type": "string",
          "const": "inconclusive"
        }
      ]
    },
    "Context2": {
      "type": "object",
      "properties": {
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "job": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "session": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "additionalProperties": false,
      "required": [
        "origin",
        "job",
        "session",
        "id"
      ]
    },
    "Origin": {
      "type": "string",
      "enum": [
        "host",
        "model"
      ]
    },
    "Phase2": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "running"
            },
            "stage": {
              "$ref": "#/$defs/Stage2"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "stage"
          ]
        },
        {
          "description": "Published only after the original history write succeeded. It cannot\naccept a contract, admit evidence or restore any native verification.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "historical"
            },
            "inputs": {
              "$ref": "#/$defs/Inputs2"
            },
            "event": {
              "type": "string",
              "pattern": "^event_[a-f0-9]{64}$"
            },
            "record_sha256": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "result": {
              "$ref": "#/$defs/ResultKind"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "inputs",
            "event",
            "record_sha256",
            "result"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "failed"
            },
            "during": {
              "$ref": "#/$defs/Stage2"
            },
            "kind": {
              "$ref": "#/$defs/FailureKind"
            },
            "message": {
              "type": "string",
              "maxLength": 8000
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "during",
            "kind",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "cancelled"
            },
            "during": {
              "$ref": "#/$defs/Stage2"
            },
            "message": {
              "type": "string",
              "maxLength": 8000
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "during",
            "message"
          ]
        }
      ]
    },
    "Stage2": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "reading_record"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "preparing"
            },
            "work": {
              "$ref": "#/$defs/Work"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "work"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "capturing"
            },
            "work": {
              "$ref": "#/$defs/Work"
            },
            "engine_sha256": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "work",
            "engine_sha256"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "recording_start"
            },
            "inputs": {
              "$ref": "#/$defs/Inputs2"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "inputs"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "building"
            },
            "inputs": {
              "$ref": "#/$defs/Inputs2"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "inputs"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "inspecting"
            },
            "inputs": {
              "$ref": "#/$defs/Inputs2"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "inputs"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "refreshing"
            },
            "inputs": {
              "$ref": "#/$defs/Inputs2"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "inputs"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "persisting"
            },
            "inputs": {
              "$ref": "#/$defs/Inputs2"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "inputs"
          ]
        }
      ]
    },
    "Work": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "requirement": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "theorems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "requirement",
        "module",
        "theorems",
        "next"
      ]
    },
    "Inputs2": {
      "type": "object",
      "properties": {
        "work": {
          "$ref": "#/$defs/Work"
        },
        "engine_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "work",
        "engine_sha256",
        "source_revision"
      ]
    },
    "ResultKind": {
      "type": "string",
      "enum": [
        "checked",
        "rejected",
        "cancelled",
        "inconclusive",
        "unavailable"
      ]
    }
  }
}
