{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "job.changed"
        },
        "job": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            },
            "inputRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "sourceRevision": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "agent_turn",
                "semantic_analysis",
                "verification"
              ]
            },
            "state": {
              "type": "string",
              "enum": [
                "queued",
                "running",
                "complete",
                "failed",
                "cancelled"
              ]
            }
          },
          "required": [
            "id",
            "workspaceId",
            "inputRevision",
            "sourceRevision",
            "kind",
            "state"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "job"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "message.delta"
        },
        "workspaceId": {
          "type": "string"
        },
        "conversationId": {
          "type": "string"
        },
        "messageId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "workspaceId",
        "conversationId",
        "messageId",
        "text"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "connection.closed"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "reason"
      ],
      "additionalProperties": false
    }
  ]
}
