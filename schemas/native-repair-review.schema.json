{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data",
  "description": "Required fields and original diagnostics, with a lossless accepted reference.",
  "type": "object",
  "properties": {
    "reference": {
      "$ref": "#/$defs/Reference"
    },
    "model": {
      "type": "string"
    },
    "processor": {
      "type": "string"
    },
    "model_definition": true,
    "finding_id": {
      "type": "string"
    },
    "requirement_id": {
      "type": "string"
    },
    "input": {
      "$ref": "#/$defs/Input"
    },
    "file": {
      "type": "string"
    },
    "accepted_reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reference2"
        },
        {
          "type": "null"
        }
      ]
    },
    "explanation": {
      "type": "string"
    },
    "diff": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "reference",
    "model",
    "processor",
    "finding_id",
    "requirement_id",
    "input",
    "file",
    "accepted_reference",
    "explanation",
    "diff"
  ],
  "$defs": {
    "Reference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^repair-[a-f0-9]{64}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ]
    },
    "Input": {
      "type": "object",
      "properties": {
        "source_revision": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "graph_revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "additionalProperties": false,
      "required": [
        "source_revision",
        "target",
        "requirement"
      ]
    },
    "Target": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "line": {
          "type": "integer",
          "format": "uint",
          "minimum": 1,
          "maximum": 1048577
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "name"
      ]
    },
    "Reference2": {
      "description": "Lossless transport of the original selected contract identity, never authority.",
      "type": "object",
      "properties": {
        "revision": {
          "$ref": "#/$defs/NativeSequence"
        },
        "session": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "contract": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "revision",
        "session",
        "contract"
      ]
    },
    "NativeSequence": {
      "type": "string",
      "format": "meden-positive-u64",
      "pattern": "^[1-9][0-9]{0,19}$",
      "maxLength": 20
    }
  }
}
