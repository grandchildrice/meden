{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference",
  "description": "Lossless transport of the original selected contract identity, never authority.",
  "type": "object",
  "properties": {
    "revision": {
      "$ref": "#/$defs/NativeSequence"
    },
    "session": {
      "$ref": "#/$defs/SessionId"
    },
    "contract": {
      "$ref": "#/$defs/ContractId"
    }
  },
  "additionalProperties": false,
  "required": [
    "revision",
    "session",
    "contract"
  ],
  "$defs": {
    "NativeSequence": {
      "type": "string",
      "format": "meden-positive-u64",
      "pattern": "^[1-9][0-9]{0,19}$",
      "maxLength": 20
    },
    "SessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "ContractId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
