{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^repair-[a-f0-9]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "sha256"
  ]
}
