{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Snapshot",
  "description": "Bounded overview projection; complete navigation stays prepared on the host.",
  "type": "object",
  "properties": {
    "generation": {
      "description": "Prepared navigation-cache generation, as a lossless canonical decimal.\nThe complete envelope ID binds this hint and all original metadata.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "files": {
      "description": "Complete source inventory, in canonical path order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Entry"
      },
      "maxItems": 250000
    },
    "navigation": {
      "description": "Binds original declaration details; the envelope also binds all metadata.",
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "indexer": {
      "description": "Original lexical implementation identity for source-bound candidate reuse.",
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "excluded": {
      "description": "Explicitly excluded directory names.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inventory_only": {
      "description": "Large inventories load already-prepared navigation in bounded chunks.",
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "generation",
    "files",
    "navigation",
    "indexer",
    "excluded",
    "inventory_only"
  ],
  "$defs": {
    "Entry": {
      "description": "Complete navigation state. Unindexed files cannot carry invented declarations.\nBorrow original validated data only while freezing the publication bytes.",
      "oneOf": [
        {
          "description": "Navigation was not indexed; no readability or proof claim is represented.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "unindexed"
            },
            "path": {
              "description": "Original relative path.",
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "bytes": {
              "description": "Original lossless byte count, including oversized inputs.",
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "path",
            "bytes"
          ]
        },
        {
          "description": "Complete observed syntax headings, without reference/description details.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "indexed"
            },
            "path": {
              "description": "Original relative path.",
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "description": "Original complete indexed text digest.",
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "description": "Original lossless byte count.",
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "declarations": {
              "description": "Original lexical declaration count.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "maximum": 1048576
            },
            "theorems": {
              "description": "Original lexical theorem count.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "maximum": 1048576
            },
            "imports": {
              "description": "Original import name candidates.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "headers": {
              "description": "Every observed declaration identity and role.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Header"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "path",
            "sha256",
            "bytes",
            "declarations",
            "theorems",
            "imports",
            "headers"
          ]
        }
      ]
    },
    "Header": {
      "description": "Declaration identity and role, without dependency strings or descriptions.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Original observed name.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "line": {
          "description": "Original one-based source line.",
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "maximum": 1048577
        },
        "kind": {
          "description": "Presentation role without a proof assertion.",
          "$ref": "#/$defs/Kind"
        },
        "declaration": {
          "description": "Original declaration spelling.",
          "type": "string"
        },
        "private": {
          "description": "Lexically observed visibility.",
          "type": "boolean"
        },
        "main_theorem": {
          "description": "Original target metadata, never a proof receipt.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "line",
        "kind",
        "declaration",
        "private",
        "main_theorem"
      ]
    },
    "Kind": {
      "description": "Presentation category, independent of the checker implementation.",
      "oneOf": [
        {
          "description": "Formal claim, without an inferred proof receipt.",
          "type": "string",
          "const": "theorem"
        },
        {
          "description": "Named definition or data declaration.",
          "type": "string",
          "const": "definition"
        },
        {
          "description": "Declared assumption.",
          "type": "string",
          "const": "axiom"
        }
      ]
    }
  }
}
