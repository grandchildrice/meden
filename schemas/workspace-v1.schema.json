                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant"
                  ]
                },
                "text": {
                  "type": "string",
                  "maxLength": 100000
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "draft",
                    "sent",
                    "received"
                  ]
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "origin": {
                  "type": "string",
                  "enum": [
                    "recorded",
                    "demo",
                    "provided"
                  ]
                },
                "activities": {
                  "maxItems": 2000,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "name": {
                        "type": "string",
                        "maxLength": 100
                      },
                      "arguments": {
                        "type": "string",
                        "maxLength": 100000
                      },
                      "output": {
                        "type": "string",
                        "maxLength": 100000
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "complete",
                          "failed",
                          "incomplete",
                          "unknown"
                        ]
                      },
                      "sourceIndex": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "id",
                      "name",
                      "arguments",
                      "output",
                      "status",
                      "sourceIndex"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "role",
                "text",
                "status",
                "createdAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "messages"
        ],
        "additionalProperties": false
      }
    },
    "reviewDrafts": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "notes": {
            "type": "string",
            "maxLength": 100000
          },
          "claimIds": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "sourceRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "inputRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "title",
          "notes",
          "claimIds",
          "sourceRevision",
          "inputRevision",
          "updatedAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "sourceRevision",
    "inputRevision",
    "origin",
    "updatedAt",
    "requirements",
    "declarations",
    "edges",
    "analyses",
    "evidence",
    "conversations",
    "reviewDrafts"
  ],
  "additionalProperties": false
}
