{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "inputRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "origin": {
      "type": "string",
      "enum": [
        "local",
        "imported",
        "sample",
        "replay"
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "requirements": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "text": {
            "type": "string",
            "maxLength": 100000
          },
          "source": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "maxLength": 4096
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "file"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "declarations": {
      "maxItems": 20000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "label": {
            "type": "string",
            "maxLength": 300
          },
          "kind": {
            "type": "string",
            "enum": [
              "theorem",
              "definition",
              "axiom"
            ]
          },
          "isMainTheorem": {
            "type": "boolean"
          },
          "statement": {
            "type": "string",
            "maxLength": 100000
          },
          "summary": {
            "type": "string",
            "maxLength": 10000
          },
          "semantic": {
            "type": "object",
            "properties": {
              "version": {
                "type": "number",
                "const": 1
              },
              "origin": {
                "type": "string",
                "const": "elaborated"
              },
              "sentence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              },
              "refutation": {
                "type": "string",
                "maxLength": 65536
              },
              "intermediate": {
                "type": "string",
                "maxLength": 65536
              },
              "renderer": {
                "type": "string",
                "maxLength": 256
              },
              "rendering_error": {
                "type": "string",
                "maxLength": 65536
              },
              "checker": {
                "type": "object",
                "properties": {
                  "engine": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "not_proposition",
                      "unsupported",
                      "counterexample",
                      "predicate_false_example",
                      "not_found",
                      "gave_up",
                      "budget_exhausted",
                      "unavailable"
                    ]
                  },
                  "candidates": {
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 8192
                    }
                  },
                  "diagnostic": {
                    "type": "string",
                    "maxLength": 65536
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "numInst": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "numRetries": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "maxSize": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "mode": {
                    "type": "string",
                    "const": "predicate"
                  }
                },
                "required": [
                  "engine",
                  "status",
                  "candidates"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "version",
              "origin",
              "sentence",
              "refutation",
              "checker"
            ],
            "additionalProperties": false
          },
          "source": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "maxLength": 4096
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "file"
            ],
            "additionalProperties": false
          },
          "proofStatus": {
            "type": "string",
            "enum": [
              "proved",
              "bounded",
              "empirical",
              "refuted",
              "unproved",
              "unknown",
              "unsupported",
              "stale"
            ]
          },
          "evidenceRefs": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "proofSourceRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "proofInputRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "axioms": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          }
        },
        "required": [
          "id",
          "name",
          "label",
          "kind",
          "statement",
          "proofStatus",
          "evidenceRefs",
          "axioms"
        ],
        "additionalProperties": false
      }
