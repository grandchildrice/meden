          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "site": {
            "type": "string",
            "enum": [
              "type",
              "value",
              "unknown"
            ]
          }
        },
        "required": [
          "source",
          "target",
          "site"
        ],
        "additionalProperties": false
      }
    },
    "analyses": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "claimId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "declarationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "inputRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sourceRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "pending",
              "failed",
              "stale"
            ]
          },
          "verdict": {
            "type": "string",
            "enum": [
              "full",
              "partial",
              "mismatch",
              "vacuous",
              "missing",
              "unformalizable",
              "unclear"
            ]
          },
          "backTranslation": {
            "type": "string",
            "maxLength": 100000
          },
          "reasoning": {
            "type": "string",
            "maxLength": 100000
          },
          "evidenceRefs": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "modelVersions": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "assumptions": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 3000
            }
          }
        },
        "required": [
          "id",
          "claimId",
          "declarationId",
          "inputRevision",
          "sourceRevision",
          "status",
          "verdict",
          "backTranslation",
          "reasoning",
          "evidenceRefs",
          "modelVersions",
          "assumptions"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "maxItems": 20000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "type": "string",
            "enum": [
              "declaration",
              "requirement",
              "counterexample",
              "report"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 300
          },
          "content": {
            "type": "string",
            "maxLength": 100000
          }
        },
        "required": [
          "id",
          "kind",
          "label",
          "content"
        ],
        "additionalProperties": false
      }
    },
    "conversations": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
