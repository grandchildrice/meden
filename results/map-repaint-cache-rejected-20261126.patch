diff --git a/apps/web/src/features/native/map-area-frame.ts b/apps/web/src/features/native/map-area-frame.ts
new file mode 100644
index 0000000..7b02177
--- /dev/null
+++ b/apps/web/src/features/native/map-area-frame.ts
@@ -0,0 +1,82 @@
+/** Disposable record of the last completed background paint. It retains only
+ * scalar geometry/style inputs, never a scene, source or semantic observation.
+ */
+export type PaintBox = {
+  path: string;
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+  depth: number;
+  color: number;
+};
+type Areas = ReadonlyArray<{ area: PaintBox; opacity: number }>;
+export type PaintView = {
+  x: number;
+  y: number;
+  zoom: number;
+  width: number;
+  height: number;
+  ratio: number;
+  font: string;
+  focused?: string;
+  policy: object;
+};
+export class AreaFrame {
+  #view?: PaintView;
+  #paths: string[] = [];
+  #values = new Float64Array(0);
+
+  invalidate() {
+    this.#view = undefined;
+  }
+
+  matches(view: PaintView, areas: Areas) {
+    const previous = this.#view;
+    if (
+      !previous ||
+      this.#paths.length !== areas.length ||
+      previous.x !== view.x ||
+      previous.y !== view.y ||
+      previous.zoom !== view.zoom ||
+      previous.width !== view.width ||
+      previous.height !== view.height ||
+      previous.ratio !== view.ratio ||
+      previous.font !== view.font ||
+      previous.focused !== view.focused ||
+      previous.policy !== view.policy
+    )
+      return false;
+    return areas.every(({ area, opacity }, i) => {
+      const p = i * 7;
+      return (
+        this.#paths[i] === area.path &&
+        this.#values[p] === area.x &&
+        this.#values[p + 1] === area.y &&
+        this.#values[p + 2] === area.width &&
+        this.#values[p + 3] === area.height &&
+        this.#values[p + 4] === area.depth &&
+        this.#values[p + 5] === area.color &&
+        this.#values[p + 6] === opacity
+      );
+    });
+  }
+
+  /** Call only after the complete synchronous paint succeeds. */
+  retain(view: PaintView, areas: Areas) {
+    const values = new Float64Array(areas.length * 7);
+    this.#paths = areas.map(({ area, opacity }, i) => {
+      const p = i * 7;
+      values[p] = area.x;
+      values[p + 1] = area.y;
+      values[p + 2] = area.width;
+      values[p + 3] = area.height;
+      values[p + 4] = area.depth;
+      values[p + 5] = area.color;
+      values[p + 6] = opacity;
+      return area.path;
+    });
+    this.#values = values;
+    this.#view = { ...view };
+  }
+}
diff --git a/apps/web/src/features/native/map-area-frame.test.ts b/apps/web/src/features/native/map-area-frame.test.ts
new file mode 100644
index 0000000..ad817ee
--- /dev/null
+++ b/apps/web/src/features/native/map-area-frame.test.ts
@@ -0,0 +1,154 @@
+import { expect, test } from "vitest";
+import fc from "fast-check";
+import { AreaFrame, type PaintBox, type PaintView } from "./map-area-frame";
+import { mapAreaColor } from "./MapSceneElements";
+
+const policy = {};
+const view = (): PaintView => ({
+  x: 3,
+  y: 5,
+  zoom: 0.7,
+  width: 800,
+  height: 600,
+  ratio: 2,
+  font: "14px Roboto",
+  policy,
+});
+const box = (): PaintBox => ({
+  path: "Root/α.lean",
+  x: 20,
+  y: 40,
+  width: 300,
+  height: 200,
+  depth: 2,
+  color: 3,
+});
+const rows = () => [{ area: box(), opacity: 0.8 }];
+
+// Independent projection of the original painter's observable command values.
+function commands(v: PaintView, areas: ReturnType<typeof rows>) {
+  return areas.map(({ area: a, opacity }) => {
+    const x = v.x + a.x * v.zoom,
+      y = v.y + a.y * v.zoom,
+      w = a.width * v.zoom,
+      h = a.height * v.zoom;
+    return {
+      rect: [x, y, w, h, Math.min(3, w / 2, h / 2)],
+      fill: [mapAreaColor(a), opacity],
+      stroke: [
+        v.focused === a.path ? "#ffe59c" : "#c7d9ee",
+        0.75 * opacity,
+        0.6,
+      ],
+      text:
+        opacity > 0.65 && w > 65 && h > 28
+          ? [a.path.split("/").at(-1), x + 10, y + Math.min(h / 2, 25), v.font]
+          : null,
+      size: [v.width, v.height, v.ratio],
+    };
+  });
+}
+
+test("paint reuse checks every represented pixel input, ordered areas and explicit invalidation", () => {
+  const original = rows(),
+    v = view(),
+    frame = new AreaFrame();
+  expect(frame.matches(v, original)).toBe(false);
+  frame.retain(v, original);
+  expect(
+    frame.matches(
+      { ...v },
+      original.map((r) => ({
+        ...r,
+        area: { ...r.area, references: ["new semantic data"] },
+      })),
+    ),
+  ).toBe(true);
+  for (const key of ["x", "y", "zoom", "width", "height", "ratio"] as const)
+    expect(frame.matches({ ...v, [key]: v[key] + 1 }, original), key).toBe(
+      false,
+    );
+  for (const changed of [
+    { font: "14px Different" },
+    { focused: original[0]!.area.path },
+    { policy: {} },
+  ])
+    expect(frame.matches({ ...v, ...changed }, original)).toBe(false);
+  for (const key of ["x", "y", "width", "height", "depth", "color"] as const) {
+    const next = rows();
+    next[0]!.area[key]++;
+    expect(frame.matches(v, next), key).toBe(false);
+  }
+  for (const changed of [
+    [{ area: { ...box(), path: "Other" }, opacity: 0.8 }],
+    [{ area: box(), opacity: 0.7 }],
+    [],
+    [...original, ...original],
+  ])
+    expect(frame.matches(v, changed)).toBe(false);
+  original[0]!.area.x++;
+  expect(frame.matches(v, original)).toBe(false); // Retention is not a mutable alias.
+  frame.retain(v, []);
+  expect(frame.matches(v, [])).toBe(true);
+  frame.invalidate();
+  expect(frame.matches(v, [])).toBe(false);
+});
+
+test("generated redraw/reuse traces preserve complete original commands and do not mutate inputs", () => {
+  const area = fc.record({
+    path: fc.constantFrom("A.lean", 'Quoted & ".lean', "Ω/B.lean"),
+    x: fc.integer({ min: 0, max: 10000 }),
+    y: fc.integer({ min: 0, max: 6600 }),
+    width: fc.integer({ min: 1, max: 5000 }),
+    height: fc.integer({ min: 1, max: 3300 }),
+    depth: fc.integer({ min: 1, max: 8 }),
+    color: fc.integer({ min: 0, max: 4 }),
+  });
+  fc.assert(
+    fc.property(
+      fc.array(
+        fc.record({
+          areas: fc.array(
+            fc.record({
+              area,
+              opacity: fc.constantFrom(0.01, 0.5, 0.65, 0.8, 1),
+            }),
+            { maxLength: 30 },
+          ),
+          pan: fc.integer({ min: -50, max: 50 }),
+          clear: fc.boolean(),
+        }),
+        { minLength: 1, maxLength: 30 },
+      ),
+      (trace) => {
+        const before = JSON.stringify(trace),
+          frame = new AreaFrame();
+        let painted: unknown;
+        for (const step of trace) {
+          const v = { ...view(), x: step.pan };
+          if (step.clear) frame.invalidate();
+          const expected = commands(v, step.areas);
+          if (frame.matches(v, step.areas)) expect(expected).toEqual(painted);
+          else {
+            frame.retain(v, step.areas);
+            painted = expected;
+          }
+          // Fresh nonpaint descriptions with the same original geometry are no-op updates.
+          const copied = step.areas.map((r) => ({
+            ...r,
+            area: { ...r.area, source: { unrelated: true } },
+          }));
+          expect(frame.matches({ ...v }, copied)).toBe(true);
+          expect(commands(v, copied)).toEqual(painted);
+          if (copied.length > 1) {
+            const reversed = [...copied].reverse();
+            if (frame.matches(v, reversed))
+              expect(commands(v, reversed)).toEqual(painted);
+          }
+        }
+        expect(JSON.stringify(trace)).toBe(before);
+      },
+    ),
+    { seed: 20261126, numRuns: 500 },
+  );
+});
