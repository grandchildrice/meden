+type Area = { id: number; color: string; name: string; path: string };
+type Frame = { type: "frame"; sequence: number; width: number; height: number; ratio: number; font: string; focus?: string; generation: number; definitions: Area[]; items: Float64Array };
+type Init = { type: "init"; canvas: OffscreenCanvas; fonts: { family: string; source: string; descriptors: FontFaceDescriptors }[] };
+const host = globalThis as unknown as { onmessage: (event: MessageEvent<Init | Frame>) => void; postMessage: (value: unknown) => void; fonts: FontFaceSet };
+let generation=0, areas=new Map<number,Area>();
+let surface: OffscreenCanvas, context: OffscreenCanvasRenderingContext2D, ready = false, frame: Frame | undefined;
+function draw() {
+ if (!ready || !frame) return;
+ const current = frame; frame = undefined;
+ const { width, height, ratio, items } = current;
+ if(generation!==current.generation){generation=current.generation;areas.clear();}
+ for(const area of current.definitions)areas.set(area.id,area);
+ const w = Math.max(1, Math.round(width * ratio)), h = Math.max(1, Math.round(height * ratio));
+ if (surface.width !== w) surface.width = w;
+ if (surface.height !== h) surface.height = h;
+ context.setTransform(ratio,0,0,ratio,0,0); context.clearRect(0,0,width,height);
+ context.font = current.font; context.textBaseline = "alphabetic";
+ for (let i=0;i<items.length;i+=6) {
+  const area=areas.get(items[i])!;
+  const x=items[i+1],y=items[i+2],w=items[i+3],h=items[i+4],opacity=items[i+5];
+  context.beginPath(); context.roundRect(x,y,w,h,Math.min(3,w/2,h/2));
+  context.fillStyle = area.color; context.globalAlpha = opacity; context.fill();
+  context.strokeStyle = current.focus === area.path ? "#ffe59c" : "#c7d9ee";
+  context.lineWidth = 0.6; context.globalAlpha = 0.75 * opacity; context.stroke();
+  if (opacity > 0.65 && w > 65 && h > 28) {context.fillStyle="white";context.globalAlpha=1;context.fillText(area.name,x+10,y+Math.min(h/2,25));}
+ }
+ context.globalAlpha = 1;
+ host.postMessage({ sequence: current.sequence });
+}
+host.onmessage = event => {
+ const message = event.data;
+ if (message.type === "init") {
+  surface = message.canvas; const selected = surface.getContext("2d"); if (!selected) throw Error("Map worker context unavailable"); context=selected;
