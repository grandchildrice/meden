+
+// Observe only existing declaration/reference primitives so initial creation does
+// not hide repeated screen-space geometry writes during subsequent zooms.
+export function observeRetainedDeclarationWrites(svg: SVGSVGElement) {
+  const labels = new Set(svg.querySelectorAll("[data-symbol-id] > text"));
+  const references = new Set(svg.querySelectorAll(".map-reference"));
+  const declarations = new Set(svg.querySelectorAll("[data-symbol-id]"));
+  const changes = {
+    labels: labels.size,
+    references: references.size,
+    transforms: 0,
+    text_geometry: 0,
+    reference_widths: 0,
+  };
+  const observe = (records: MutationRecord[]) => {
+    for (const record of records) {
+      const name = record.attributeName;
+      if (declarations.has(record.target as Element) && name === "transform")
+        changes.transforms++;
+      if (
+        labels.has(record.target as Element) &&
+        ["x", "y", "font-size"].includes(name!)
+      )
+        changes.text_geometry++;
+      if (references.has(record.target as Element) && name === "stroke-width")
+        changes.reference_widths++;
+    }
+  };
+  const observer = new MutationObserver(observe);
+  observer.observe(svg, {
+    attributes: true,
+    subtree: true,
+    attributeFilter: ["transform", "x", "y", "font-size", "stroke-width"],
+  });
+  (window as any).__declarationWrites = () => {
+    observe(observer.takeRecords());
+    observer.disconnect();
+    return changes;
+  };
+}
