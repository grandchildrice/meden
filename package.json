{
  "name": "meden-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev --workspace @meden/web",
    "build": "npm run typecheck && npm run build --workspace @meden/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:gui": "playwright test --config apps/web/playwright.config.ts",
    "architecture:check": "node --test tools/architecture/boundaries.test.mjs && node tools/architecture/check.mjs",
    "format:check": "prettier --check apps/web packages tools/gui tools/perf tools/architecture docs/gui.md docs/architecture package.json tsconfig.json vitest.config.ts",
    "format": "prettier --write apps/web packages tools/gui tools/perf tools/architecture docs/gui.md docs/architecture package.json tsconfig.json vitest.config.ts",
    "schema:export": "node --experimental-strip-types tools/gui/export-schema.ts",
    "schema:check": "npm run schema:export && git diff --exit-code -- schemas/",
    "test:fuzz": "MEDEN_FUZZ_RUNS=3000 vitest run apps/web/src/features/native/project-map-corpus.test.ts",
    "test:performance": "MEDEN_PERFORMANCE=1 vitest run apps/web/src/features/native/project-map-corpus.test.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@jridgewell/trace-mapping": "0.3.31",
    "@playwright/test": "1.65.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fast-check": "4.11.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0",
    "vitest": "^3.1.4"
  }
}
