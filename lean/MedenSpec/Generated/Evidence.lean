      if b1
      then
        let b2 ←
          evidence.Contracts.eligible current1 self.agreement.revision
            output_inputs
        if b2
        then ok (some output, current1)
        else
          let (_, current2) ←
            evidence.Contracts.abort current1
              evidence.EvidenceOrigin.Controller self.ticket
          ok (none, current2)
      else
        let (_, current2) ←
